# Semua env var yang dibaca aplikasi ini (lihat src/lib/firebase/env.ts).
# Nilai di bawah sengaja kosong. Untuk dev/emulator lokal, pakai
# .env.local.example (sudah terisi nilai dummy emulator) sebagai gantinya.
# Jangan commit .env.local.

# -----------------------------------------------------------------------------
# Firebase client (NEXT_PUBLIC_* — terekspos ke browser). Dipakai src/lib/firebase/client.ts.
# apiKey, authDomain, projectId, appId WAJIB diisi (readFirebaseClientConfig()
# akan gagal parse kalau salah satu kosong, kecuali mode emulator aktif).
# storageBucket dan messagingSenderId OPSIONAL.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# -----------------------------------------------------------------------------
# Saklar mode emulator vs produksi. OPSIONAL, tapi WAJIB diisi eksplisit
# "false" di Vercel Production kalau tidak yakin NODE_ENV akan "production"
# (lihat shouldUseFirebaseEmulator() di env.ts).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=

# -----------------------------------------------------------------------------
# Firebase Admin SDK (server-only, "server-only" import). TIDAK dipakai oleh
# aplikasi yang di-deploy — admin.ts tidak diimpor dari mana pun di src/app.
# Hanya dibutuhkan untuk menjalankan scripts/*.ts (mis. seed-dev.ts) secara
# lokal. Boleh dikosongkan di Vercel.
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_USE_EMULATOR=
