# Salin file ini menjadi .env.local:
#   copy .env.local.example .env.local
# Jangan commit .env.local.
# Setelah mengubah file ini, restart `npm run dev`.
# Panduan lengkap: docs/SETUP-EMULATOR.md

# -----------------------------------------------------------------------------
# Mode emulator (wajib true untuk tes lokal)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
FIREBASE_ADMIN_USE_EMULATOR=true

# Host yang dibaca Admin SDK. Client SDK memakai connect*Emulator di client.ts.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# -----------------------------------------------------------------------------
# Firebase client (NEXT_PUBLIC_* terekspos ke browser)
# Untuk EMULATOR: nilai dummy di bawah sudah cukup, asalkan
# NEXT_PUBLIC_FIREBASE_PROJECT_ID = demo-tna-kompetensi (.firebaserc).
# Untuk PRODUCTION: ganti semua nilai dengan config dari Firebase Console.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=demo-tna-kompetensi-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-tna-kompetensi.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-tna-kompetensi
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-tna-kompetensi.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0
NEXT_PUBLIC_FIREBASE_APP_ID=1:0:web:demo-tna-kompetensi

# -----------------------------------------------------------------------------
# Firebase Admin SDK (server-only)
# Emulator: cukup project id. client_email + private_key tidak wajib.
# Production: isi ketiga variabel dari service account JSON.
# FIREBASE_ADMIN_PRIVATE_KEY memakai \n untuk baris baru.
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=demo-tna-kompetensi
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
